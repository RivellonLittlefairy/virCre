<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <ProjectReference Include="../VirCre.Presentation/VirCre.Presentation.csproj" />
    <Content Include="../../android-agent/build/icon-agent.jar" Link="Assets/icon-agent.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishXamlResourceIndex" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="_GenerateProjectPriFile">
    <!-- Unpackaged dotnet publish does not automatically include the generated application PRI. -->
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The generated XAML resource index is missing: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
  <Target Name="BuildIconAgent" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/Build-IconAgent.ps1&quot;" />
  </Target>
  <Target Name="PrepareBundledScrcpy" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/Prepare-ScrcpyRuntime.ps1&quot;" />
    <ItemGroup>
      <_ScrcpyRuntime Include="$(MSBuildProjectDirectory)/../../.cache/bundled-runtime/scrcpy/**/*" />
      <Content Include="@(_ScrcpyRuntime)" Link="runtime/scrcpy/%(_ScrcpyRuntime.RecursiveDir)%(_ScrcpyRuntime.Filename)%(_ScrcpyRuntime.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
