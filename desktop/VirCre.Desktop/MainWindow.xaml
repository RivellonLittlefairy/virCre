<Window
    x:Class="VirCre.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:VirCre.Presentation"
    xmlns:launcher="using:VirCre.Launcher"
    Title="virCre · 手机应用">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Language="zh-CN" Loaded="Root_Loaded">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Margin="20,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" Background="#316D66" CornerRadius="7">
                    <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="White" />
                </Border>
                <TextBlock Text="virCre" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="手机应用，桌面体验" FontSize="12" Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="224"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="True"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="14,12,14,22">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8EA;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="DeviceName" Text="未选择设备" FontWeight="SemiBold" FontSize="13" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DeviceHint" Text="刷新并选择手机" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ComboBox x:Name="DevicePicker" PlaceholderText="选择手机" HorizontalAlignment="Stretch" SelectionChanged="DevicePicker_SelectionChanged" AutomationProperties.Name="选择手机">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="launcher:PhoneDevice">
                                <StackPanel MaxWidth="300" Spacing="2" ToolTipService.ToolTip="{x:Bind Serial}">
                                    <TextBlock Text="{x:Bind DisplayLabel}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Serial}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="RefreshDevices" Content="刷新设备与应用" HorizontalAlignment="Stretch" Click="RefreshDevices_Click" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="全部应用" Tag="apps"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="收藏" Tag="favorites"><NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="运行中" Tag="running"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="22,12,16,18" Spacing="5">
                    <TextBlock Text="WORKSPACE" FontSize="10" CharacterSpacing="120" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="你的手机应用工作台" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12,0,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Margin="0,0,0,0">
                <Grid Padding="28,24,28,16" RowSpacing="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="PageTitle" Text="全部应用" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="PageDescription" Style="{StaticResource SectionHint}" Text="手机上的应用，在桌面从容使用。" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="10,5" VerticalAlignment="Top" Margin="0,7,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="#7C9B94" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionStatus" Text="未连接" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="SearchRow" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索应用名称或包名" QueryIcon="Find" TextChanged="Search_TextChanged"
                                        AutomationProperties.Name="搜索应用" HorizontalAlignment="Stretch" MaxWidth="380" />
                        <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="20" Height="20" IsActive="False" />
                        <TextBlock x:Name="AppCount" Grid.Column="2" Text="0 个应用" Style="{StaticResource SectionHint}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <GridView x:Name="AppGrid" SelectionMode="None" IsItemClickEnabled="False" Padding="0,0,0,8" Margin="-6,0,-6,0" SizeChanged="AppGrid_SizeChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="6,0,6,12" /></Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="presentation:AppCard">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="16">
                                        <Grid RowSpacing="11">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Border Background="{Binding Color, Converter={StaticResource ColorBrush}}" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="White" />
                                                </Border>
                                                <Button Background="Transparent" BorderThickness="0" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Click="Favorite_Click" Tag="{x:Bind PackageName}" AutomationProperties.Name="{x:Bind FavoriteLabel}"
                                                        ToolTipService.ToolTip="{x:Bind FavoriteLabel}">
                                                    <FontIcon Glyph="{x:Bind FavoriteGlyph}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind PackageName}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind KindLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="打开应用" IsEnabled="False" HorizontalAlignment="Stretch" FontSize="12" MinHeight="28" Padding="10,3"
                                                    ToolTipService.ToolTip="独立开窗将在下一阶段接入" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="390" Margin="20">
                            <Border Width="72" Height="72" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="20" HorizontalAlignment="Center">
                                <FontIcon x:Name="EmptyIcon" Glyph="&#xE8A9;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="EmptyDescription" Style="{StaticResource SectionHint}" TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer x:Name="SettingsContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE790;" FontSize="18" /><TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                                        <TextBlock Text="选择适合你的界面主题。" Style="{StaticResource SectionHint}" />
                                        <RadioButtons x:Name="ThemeChoice" SelectedIndex="0" MaxColumns="3" SelectionChanged="Theme_SelectionChanged">
                                            <x:String>跟随系统</x:String><x:String>浅色</x:String><x:String>深色</x:String>
                                        </RadioButtons>
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="关于这个版本" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="应用名称和包名由程序实时从所选手机读取。当前支持设备选择、刷新、搜索与临时收藏；独立开窗将在下一阶段加入。" Style="{StaticResource SectionHint}" />
                                        <TextBlock Text="应用图标暂用统一占位图形。" Style="{StaticResource SectionHint}" />
                                        <TextBlock Text="主题与收藏只在本次运行中生效。" Style="{StaticResource SectionHint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                            <TextBlock x:Name="FooterStatus" Grid.Column="1" Text="连接手机后读取应用。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
